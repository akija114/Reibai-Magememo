rules_version = '2';
// CAD図面編集「仲間と共有」用のルール
// ・合言葉を知っている人だけが参加できる（参加した人＝メンバーだけが中身を読める・書ける）
// ・消した物は残る（gone:true）。本当に消す「完全削除」はグループを作った人だけ
// 曲げ共有「チームに送る」用（teams）：送ったリンク（チームの番号入り）を開いた人がメンバーになる。メンバーだけが中身・既読を読める。
// 既読（views）は自分の分だけ書ける。送った物を直す・消すのは送った人だけ
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(code) { return signedIn() && exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid)); }
    function isOwner(code) { return signedIn() && get(/databases/$(database)/documents/groups/$(code)).data.owner == request.auth.uid; }

    // 曲げ共有の短いリンク（…/?s=番号）：番号を知っている人だけが読める（一覧は出せない）。作るだけで、直す・消すはできない
    match /links/{id} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['z','at']) && request.resource.data.z is string && request.resource.data.z.size() < 300000;
      allow update, delete: if false;
    }
    function tMember(tid) { return signedIn() && exists(/databases/$(database)/documents/teams/$(tid)/members/$(request.auth.uid)); }
    match /teams/{tid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /members/{uid} {
        allow read: if tMember(tid);
        allow create, update: if signedIn() && request.auth.uid == uid && exists(/databases/$(database)/documents/teams/$(tid));
        allow delete: if signedIn() && (request.auth.uid == uid || get(/databases/$(database)/documents/teams/$(tid)).data.owner == request.auth.uid);
      }
      match /shares/{sid} {
        allow read: if tMember(tid);
        allow create: if tMember(tid) && request.resource.data.by == request.auth.uid;
        allow update, delete: if tMember(tid) && resource.data.by == request.auth.uid;
        match /views/{uid} {
          allow read: if tMember(tid);
          allow create, update: if tMember(tid) && request.auth.uid == uid;
        }
      }
    }
    // 現場「会社で現場を一緒に見る」（cos）：招待のリンクを開いた人は「許可待ち」で入る。社長（作った人）と番頭（role boss・bantou）が許可・直せる／見るだけを決める。
    // 番頭を決める・外すのは社長だけ（番頭は「なかま」の許可だけ変えられる）。
    // データは種類ごと（c/{種類}/p/{番号}：ros 名簿・site 現場・off 休み・money 残業と交通費）。その種類を許可された人だけが読める（money は社長・番頭だけ）。
    // 直す＝その種類を読めて、社長・番頭か「直せる（edit）」の人。消す・なかまを外すのは社長・番頭だけ
    function cmem(cid) { return get(/databases/$(database)/documents/cos/$(cid)/mem/$(request.auth.uid)).data; }
    function cHas(cid) { return signedIn() && exists(/databases/$(database)/documents/cos/$(cid)/mem/$(request.auth.uid)); }
    function cOwner(cid) { return signedIn() && get(/databases/$(database)/documents/cos/$(cid)).data.owner == request.auth.uid; }
    function cOk(cid) { return cHas(cid) && cmem(cid).st == 'ok'; }
    function cAdm(cid) { return cOwner(cid) || (cOk(cid) && cmem(cid).role in ['boss', 'bantou']); }
    function cCan(cid, k) { return cAdm(cid) || (cOk(cid) && cmem(cid).perms.get(k, false) == true); }
    match /cos/{cid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if cAdm(cid) && request.resource.data.owner == resource.data.owner;
      allow delete: if cOwner(cid);
      match /mem/{uid} {
        allow read: if cOk(cid) || cOwner(cid) || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid && exists(/databases/$(database)/documents/cos/$(cid))
          && ((request.resource.data.st == 'wait' && request.resource.data.role == 'mem' && request.resource.data.perms.size() == 0) || cOwner(cid));
        allow update: if cOwner(cid)
          || (cAdm(cid) && resource.data.role == 'mem' && request.resource.data.role == 'mem')
          || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'at']));
        allow delete: if cOwner(cid) || (cAdm(cid) && resource.data.role == 'mem') || (signedIn() && request.auth.uid == uid);
      }
      match /c/{cat}/p/{pid} {
        allow read: if cCan(cid, cat);
        allow create, update: if cCan(cid, cat) && (cAdm(cid) || cCan(cid, 'edit'));
        allow delete: if cAdm(cid);
      }
      match /lph/{phid} {
        allow read: if cCan(cid, 'lic');
        allow create, update: if cAdm(cid) || cCan(cid, 'edit');
        allow delete: if cAdm(cid);
      }
    }
    match /groups/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid && request.resource.data.n == 1;
      allow update: if isOwner(code)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
            && request.resource.data.n == resource.data.n + 1);
      allow delete: if isOwner(code);

      match /members/{uid} {
        allow read: if isMember(code) || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if isOwner(code) || (signedIn() && request.auth.uid == uid);
      }
      match /drw/{fid} {
        allow read, create, update: if isMember(code);
        allow delete: if isOwner(code);
        match /file/{i} {
          allow read, create: if isMember(code);
          allow update, delete: if isOwner(code);
        }
        match /items/{key} {
          allow read, create, update: if isMember(code);
          allow delete: if isOwner(code);
        }
      }
    }
  }
}
